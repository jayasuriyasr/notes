# ---------------------------------------------------------------------
# Supabase - Project Settings > API
# ---------------------------------------------------------------------
# Both of these are PUBLIC. Vite inlines any VITE_-prefixed variable into
# the JavaScript bundle, so treat them as visible to the world - because
# they are. That is fine: the anon key grants no privileges of its own,
# it only identifies the request as the `anon` Postgres role. Every
# permission decision is made by RLS inside the database.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public site origin, used for canonical URLs, Open Graph tags and sitemap.xml
VITE_SITE_URL=https://docs.example.com
VITE_SITE_NAME=Documentation

# ---------------------------------------------------------------------
# NEVER put SUPABASE_SERVICE_ROLE_KEY in this file or in any VITE_
# variable. The service role bypasses RLS completely. If it ever reaches
# the browser, every draft is public and every row is writable by anyone.
# It belongs only in server-side environments, and this app has none.
# ---------------------------------------------------------------------
